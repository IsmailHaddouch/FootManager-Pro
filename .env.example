# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le fichier .env.

# --- Base de données ---
DB_NAME=footmanager
DB_USER=footmanager
DB_PASSWORD=footmanager
DB_URL=jdbc:postgresql://localhost:5432/footmanager

# --- Sécurité ---
# Au moins 32 caractères. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-1234
JWT_EXPIRATION_MINUTES=60

# --- Application ---
# "dev" active les comptes de démonstration. Ne JAMAIS utiliser "dev" en production.
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Paiement en ligne (à renseigner une fois le prestataire marocain choisi) ---
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# --- E-mail (notifications) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
